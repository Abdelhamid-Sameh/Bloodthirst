  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 232e6cc4f8493e343b3d9580c12d0c86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CastleEnding
  marchIntro: {fileID: 8300000, guid: 14483214860524e4da852096760ac8a4, type: 3}
  marchLoop: {fileID: 8300000, guid: b291aff534bca5b4dbc88c01d4942d50, type: 3}
  marchVolume: 0.55
  wind: {fileID: 8300000, guid: 961dabec6d84ed240a28eba719f0551b, type: 3}
  windVolume: 0.35
  gateLeafA: {fileID: 93561564}
  gateLeafB: {fileID: 93561563}
  gateDelay: 4
  gateCloseTime: 5.5
  gateSound: {fileID: 8300000, guid: f0b80fb168d78b7459e2c192f4c2ee7e, type: 3}
  newsVoice: {fileID: 8300000, guid: 660d2743bb5d95548bb28f2b581b5465, type: 3}
  newsScript: 'Good evening. We interrupt our program, once again, with breaking
    news.

    Less than an hour ago, the man arrested last night escaped from police
    custody.

    Officers say an experimental serum, H-7, was meant to hold him...
    It did not.

    Shortly after, witnesses saw hundreds of people walking out
    of the city... police officers among them... in complete silence.

    They did
    not answer when their names were called. They did not stop.

    Fires are burning
    tonight across the streets they left behind.

    Their trail leads west, along
    the desert road, to the old castle beyond the city limits. Its gates are now
    closed.

    Authorities are urging everyone to stay indoors, to lock their doors...
    and not to open them, even for someone you know.

    I''m being told... our
    crew at the castle has stopped responding.

    We''ll bring you more on this
    story... if we can.'
  headline: THE CITY WALKS INTO THE DESERT
  tickerText: "POLICE STATION BREACHED  \u2022  SERUM H-7 FAILED  \u2022  HUNDREDS
    MISSING  \u2022  FIRES IN THE CITY CENTRE  \u2022  STAY INDOORS AFTER DARK  \u2022 
    CASTLE CREW NOT RESPONDING  \u2022  "
  shots:
  - {fileID: 122626157}
  - {fileID: 796994431}
  - {fileID: 90016718}
  - {fileID: 1473461658}
  shotDrift: 3
  fires: {fileID: 966932618}
  title: BLOODTHIRST
  subtitle: Thank you for playing
  credits: '<size=72><color=#C21E1E>BLOODTHIRST</color></size>


    A DMET 909 project

    German
    University in Cairo



    <size=44><color=#C21E1E>Abdelhamid Sameh Ali</color></size>

    Level
    Design & Environments, Camera, UI, Cutscenes, Audio & Music, Integration & Builds


    <size=44><color=#C21E1E>Sohaila
    Omara</color></size>

    Characters & Animation


    <size=44><color=#C21E1E>Ahmed
    Mohamed El-Sayed</color></size>

    Police AI & Combat, the Armoured Officer


    <size=44><color=#C21E1E>Ali
    Hesham</color></size>

    Vampire Abilities & Gameplay



    <size=44><color=#C21E1E>Third-party
    assets</color></size>


    POLYGON city pack

    Simple Vehicle Pack

    Low
    Poly Police Station (free)

    Modular Castle

    EmaceArt - Raft on the Desert

    Batwing
    health bar (itch.io)

    Characters and animations: Mixamo

    Sand texture:
    ambientCG (CC0)

    Sound effects: Pixabay, freesound, ElevenLabs

    Voices:
    ElevenLabs

    Music made in Bosca Ceoil




    <i>The night is his.</i>'
  creditsMusic: {fileID: 8300000, guid: 3494d5b2ebbaa0a4e9831c7fed3fefe1, type: 3}
  creditsVolume: 0.6
  creditsSeconds: 70
  menuScene: MainMenu
